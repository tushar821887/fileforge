# FormatFlow Environment Configuration Template

# Server Port
PORT=3000

# Environment: development, staging, production
NODE_ENV=development

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# File Storage & Retention
STORAGE_PATH=./storage/temp
MAX_FILE_SIZE_MB=50
MAX_BATCH_FILES=10
FILE_RETENTION_MINUTES=60
CLEANUP_INTERVAL_CRON=0 * * * *

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Optional External Conversion Engines
SOFFICE_PATH=
